# DonutSMP Stats API - Environment Configuration

# Minecraft Authentication (Microsoft)
# Get session token from https://login.live.com/ or use the Yggdrasil flow
MINECRAFT_SESSION_TOKEN=your_microsoft_session_token_here
MC_USERNAME=your_minecraft_username

# DonutSMP Server Configuration
MC_SERVER=donutsmp.net
MC_SERVER_PORT=25565

# API Authentication
STATS_API_KEY=your_secure_api_key_here

# Optional: Proxy configuration (socks5:// or http://)
# MC_PROXY=socks5://user:pass@host:port

# API Server
API_HOST=127.0.0.1
API_PORT=8000
